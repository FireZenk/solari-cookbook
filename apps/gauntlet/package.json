{
  "name": "gauntlet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EU compliance evidence engine built on Solari \u2014 pre-consent tracker forensics and real keyboard/accessibility audits, with a reproducible evidence bundle.",
  "license": "MIT",
  "scripts": {
    "gauntlet": "node --env-file-if-exists=.env src/cli.ts",
    "preflight": "node --env-file-if-exists=.env src/preflight.ts",
    "serve": "node --env-file-if-exists=.env src/serve.ts",
    "sample": "node scripts/sample-report.ts docs/sample-report.html",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.2",
    "@solarisdk/sdk": "^0.1.2",
    "patchright-core": "^1.62.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
